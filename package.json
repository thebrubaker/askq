{
  "name": "askq",
  "version": "0.2.0",
  "description": "Ask one question of a whole dataset and get back what to read. One model call sees every item; code checks that every item came back.",
  "type": "module",
  "bin": {
    "askq": "bin/askq.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/entry.ts --target=node --outfile dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "author": "Digital Pine (https://digitalpine.io)",
  "homepage": "https://github.com/thebrubaker/askq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebrubaker/askq.git"
  },
  "bugs": {
    "url": "https://github.com/thebrubaker/askq/issues"
  },
  "keywords": [
    "cli",
    "jsonl",
    "llm",
    "gemini",
    "triage",
    "discourse",
    "twitter",
    "jq",
    "agents"
  ]
}
